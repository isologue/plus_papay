# ===== Server =====
PORT=3000
JSON_BODY_LIMIT=15mb
# 留空将基于 cwd 派生
ADMIN_TOKEN_SECRET=
# 首次启动后请到「系统配置」修改
ADMIN_PASSWORD=admin

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 必填：MySQL 密码
DB_PASSWORD=
DB_NAME=plus_papay
DB_POOL_LIMIT=60

# ===== 浏览器 =====
# 1 = 有头模式（调试用）
HEADFUL=0
# 1 = 输出脱敏的 OpenAI 登录网络状态（仅调试用）
OPENAI_NETWORK_DEBUG=0
# 1 = HTTP 代理随机断开 OpenAI CDN 的 HTTP/2 流时启用
OPENAI_FORCE_HTTP1=0

# ===== 可选 Cloudflare 自动校验诊断 =====
# 1 = 在每次注册开始前通过同一出口请求 FlareSolverr；默认关闭，便于随时回退。
OPENAI_FLARESOLVERR=0
# Docker 内部服务地址；不需要也不要映射到 Windows 宿主机。
FLARESOLVERR_URL=http://flaresolverr:8191
# FlareSolverr 单次校验的最长等待秒数。
FLARESOLVERR_TIMEOUT_SEC=60
# 1 = 将 FlareSolverr 返回的 openai.com Cookie 注入本次 Playwright 上下文；
# 仅在诊断确认同一代理出口可用后开启，默认不注入以避免跨浏览器指纹失配。
OPENAI_FLARESOLVERR_APPLY_COOKIES=0
# 留空使用 Playwright 自带 Chromium；可选 chrome / msedge
CHROMIUM_CHANNEL=

# ===== ChatGPT / Stripe（用于创建 Plus 订单的客户端 token，构建时由后端动态注入即可）=====
CHATGPT_TOKEN=
STRIPE_KEY=

# ===== Billing 默认值（可选；不填则全部从「资产池」按任务取卡 / 取手机号 / 取地址）=====
BILLING_COUNTRY=US
BILLING_ADDRESS=
BILLING_CITY=
BILLING_STATE=
BILLING_ZIP=
BILLING_NAME=
# PayPal 注册邮箱，留空则随机生成 @hotmail.com
BILLING_EMAIL=
BILLING_PHONE=
PAYPAL_PASSWORD=

# ===== 银行卡（建议放在「资产池」管理，不要走环境变量）=====
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=

# ===== 短信接码 API（接收 PayPal SMS）=====
SMS_API_KEY=

# ===== 代理（强烈建议使用住宅代理，支持 {session} 占位符做 sticky session）=====
# 示例：http://USER:PASS@your-proxy-host:1000
# 示例：http://USER-session-{session}:PASS@your-proxy-host:1000
PROXY=

# ===== 邮箱通道 =====
# 临时邮箱 API（兼容 cloudflare_temp_email）
# 如：https://your-temp-email.example.com
INBOX_API_BASE=
# 临时邮箱可用域名（多行/逗号分隔）；为空则由后台「系统配置」管理
INBOX_EMAIL_DOMAINS=
# 自定义随机邮箱域名（用于 OpenAI 注册）
RANDOM_EMAIL_DOMAIN=
